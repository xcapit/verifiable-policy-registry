{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xcapit/verifiable-policy-registry/schemas/deployment-manifest.schema.json",
  "title": "VPR deployment manifest (format 1)",
  "description": "Published by the deploying partners, not by the operator alone. Verifiers pin these values instead of trusting scope names. License: CC0-1.0. See docs/INTERFACES.md.",
  "type": "object",
  "required": ["format", "network", "chainId", "contracts", "finality", "scopes", "publishedBy"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "vpr-manifest/1" },
    "network": { "type": "string", "minLength": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "contracts": {
      "type": "object",
      "required": ["registry", "anchor"],
      "additionalProperties": false,
      "properties": {
        "registry": { "$ref": "#/$defs/address" },
        "anchor": { "$ref": "#/$defs/address" },
        "eas": { "$ref": "#/$defs/address", "description": "EAS contract the resolvers accept calls from" },
        "easSchemaRegistry": { "$ref": "#/$defs/address" },
        "resolvers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deployment": { "$ref": "#/$defs/address" },
            "independentTest": { "$ref": "#/$defs/address" },
            "conformance": { "$ref": "#/$defs/address" }
          }
        },
        "easSchemaUids": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/bytes32" }
        }
      }
    },
    "finality": { "enum": ["finalized", "safe", "latest"], "description": "Block tag at which verifiers read state before treating a record as final. On OP Stack, finalized means derived from finalized L1 blocks; latest (unsafe) is acceptable only for a local demonstrator" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "scopeId", "governor", "issuers", "publisher", "maxLagDays"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Z]{2}:[a-z0-9-]+$" },
          "scopeId": { "$ref": "#/$defs/bytes32", "description": "keccak256(abi.encode(governor, name))" },
          "governor": { "$ref": "#/$defs/address" },
          "governorThreshold": { "type": "string", "pattern": "^[0-9]+-of-[0-9]+$", "description": "Declared Safe threshold, checked by verifiers against the Safe itself" },
          "issuers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operator": { "type": "array", "items": { "$ref": "#/$defs/address" } },
              "reviewer": { "type": "array", "items": { "$ref": "#/$defs/address" } },
              "auditor": { "type": "array", "items": { "$ref": "#/$defs/address" } }
            }
          },
          "publisher": { "$ref": "#/$defs/address" },
          "maxLagDays": { "type": "integer", "minimum": 1, "maximum": 4294967295, "description": "Back-fill window in days; 4294967295 (NO_LAG_LIMIT) disables the bound" },
          "charterHash": { "$ref": "#/$defs/bytes32" }
        }
      }
    },
    "publishedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "note": { "type": "string" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
